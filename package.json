{
  "name": "mcp-trend-tracker",
  "version": "1.0.0",
  "description": "A comprehensive tracker for Model Context Protocol (MCP) adoption trends and community growth",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "build": "webpack --mode production",
    "serve": "http-server ./",
    "scrape": "node src/scrapers/index.js",
    "analyze": "node src/analytics/trend-analyzer.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai",
    "anthropic",
    "trend-tracking",
    "github-api",
    "analytics",
    "open-source"
  ],
  "author": "MCP Community",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.2",
    "cheerio": "^1.0.0-rc.12",
    "express": "^4.18.2",
    "node-cron": "^3.0.3",
    "sqlite3": "^5.1.6",
    "winston": "^3.11.0",
    "dotenv": "^16.3.1",
    "moment": "^2.29.4",
    "chart.js": "^4.4.0",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "eslint": "^8.56.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "http-server": "^14.1.1",
    "@types/node": "^20.10.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/username/mcp-trend-tracker.git"
  },
  "bugs": {
    "url": "https://github.com/username/mcp-trend-tracker/issues"
  },
  "homepage": "https://github.com/username/mcp-trend-tracker#readme",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}