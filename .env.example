# GitHub API Configuration
GITHUB_TOKEN=your_github_personal_access_token_here

# Twitter API Configuration
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# Reddit API Configuration
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=MCP-Trend-Tracker/1.0

# Database Configuration
DATABASE_URL=./data/mcp-trends.db

# Application Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Scraping Configuration
SCRAPE_INTERVAL_HOURS=6
MAX_REQUESTS_PER_MINUTE=60
ENABLE_GITHUB_SCRAPING=true
ENABLE_NPM_SCRAPING=true
ENABLE_REDDIT_SCRAPING=true
ENABLE_TWITTER_SCRAPING=false

# Analytics Configuration
GENERATE_DAILY_REPORTS=true
REPORT_TIME=09:00
RETENTION_DAYS=90

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Notification Settings
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here
SLACK_WEBHOOK_URL=your_slack_webhook_url_here
EMAIL_NOTIFICATIONS=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_password_here

# Feature Flags
ENABLE_REAL_TIME_UPDATES=true
ENABLE_TREND_PREDICTIONS=false
ENABLE_SENTIMENT_ANALYSIS=false